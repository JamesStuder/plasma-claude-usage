#!/usr/bin/env python3
"""claude-usage: Claude Code plan limits + token usage, for the Plasma widget (or a terminal).

  claude-usage [--json]     JSON: {plan, limits, today, days, models, ...}
  claude-usage --text       human-readable summary
  claude-usage --refresh    ignore the 5-minute cache for the limits
  claude-usage --open       run open_command (widget: right click / button)
  claude-usage --running    "on" if Claude Code is running, else "off"
  claude-usage --set-model <id>   type "/model <id>" into the Claude session (needs tmux_target)

Limits come from the same endpoint Claude Code's /usage command uses, called with
Claude Code's existing login at most every 5 minutes (cached in
~/.cache/claude-usage/). The login is only read, never refreshed, so this can't
interfere with Claude Code; if the token has expired the last numbers are shown
until Claude Code renews it. The endpoint is not a documented public API and may
change.

Token counts are summed from Claude Code's local session logs, de-duplicated per
message, by local day.

Config: ~/.config/claude-usage/config.toml (see config.example.toml).
"""
import json, os, shlex, shutil, subprocess, sys, time, tomllib, urllib.error, urllib.request
from datetime import datetime
from pathlib import Path

HOME = Path.home()
CLAUDE_DIR = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".claude"))
CREDS = CLAUDE_DIR / ".credentials.json"
PROJECTS = CLAUDE_DIR / "projects"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "claude-usage"
CONFIG_FILE = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "claude-usage" / "config.toml"
DEFAULTS = {
    "open_command": "konsole -e claude",
    "tmux_target": "",        # e.g. "-L claude -t claude" — enables the model buttons
    "models": [["Fable 5.1", "claude-fable-5-1"], ["Opus 5.5", "claude-opus-5-5"],
               ["Sonnet 5", "claude-sonnet-5"], ["Haiku 4.5", "claude-haiku-4-5-20251001"]],
}


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE, "rb") as f:
            cfg.update(tomllib.load(f))
    except FileNotFoundError:
        pass
    except tomllib.TOMLDecodeError as e:
        print(f"config error in {CONFIG_FILE}: {e}", file=sys.stderr)
    return cfg


CFG = load_config()
LIMITS_TTL = 300
URL = "https://api.anthropic.com/api/oauth/usage"


def fetch_limits():
    cache = CACHE / "limits.json"
    try:
        old = json.loads(cache.read_text())
    except Exception:
        old = {}
    if old and time.time() - old.get("fetched", 0) < LIMITS_TTL and "--refresh" not in sys.argv:
        return old
    try:
        tok = json.loads(CREDS.read_text())["claudeAiOauth"]["accessToken"]
        req = urllib.request.Request(URL, headers={"Authorization": f"Bearer {tok}",
                                                   "anthropic-beta": "oauth-2025-04-20",
                                                   "User-Agent": "claude-code"})
        data = json.loads(urllib.request.urlopen(req, timeout=10).read())
    except urllib.error.HTTPError as e:
        return {**old, "error": "login expired (open Claude Code)" if e.code == 401 else f"HTTP {e.code}"}
    except Exception as e:
        return {**old, "error": f"offline ({type(e).__name__})"}
    limits = []
    for l in data.get("limits") or []:
        scope = ((l.get("scope") or {}).get("model") or {}).get("display_name")
        label = {"session": "Session (5 h)", "weekly_all": "Weekly · all models"}.get(l.get("kind"))
        if scope:
            label = f"Weekly · {scope}"
        limits.append({"label": label or l.get("kind", "?"), "kind": l.get("kind"),
                       "percent": l.get("percent", 0), "severity": l.get("severity"),
                       "resets_at": l.get("resets_at")})
    extra = data.get("extra_usage") or {}
    out = {"limits": limits, "fetched": time.time(), "error": None,
           "extra_used": extra.get("used_credits") if extra.get("is_enabled") else None}
    CACHE.mkdir(parents=True, exist_ok=True)
    cache.write_text(json.dumps(out))
    return out


def model_name(m):
    m = (m or "?").removeprefix("claude-")
    parts = m.split("-")
    if len(parts) >= 2 and parts[0].isalpha():
        ver = ".".join(p for p in parts[1:3] if p.isdigit())
        return f"{parts[0].title()} {ver}".strip()
    return m


def plan():
    try:
        login = json.loads(CREDS.read_text())["claudeAiOauth"]
    except Exception:
        return ""
    import re
    sub = str(login.get("subscriptionType") or "").title()
    m = re.search(r"max_(\d+x)", str(login.get("rateLimitTier") or ""), re.I)
    tier = f"Max {m.group(1)}" if m else ""
    return " · ".join(p for p in (sub, tier) if p and p != tier.split()[0])


def token_stats(days=7):
    """Tokens per local day (last `days`) and per model (today), from the session logs."""
    now = datetime.now().astimezone()
    midnight = now.replace(hour=0, minute=0, second=0, microsecond=0)
    from datetime import timedelta
    first = midnight - timedelta(days=days - 1)
    cutoff = first.timestamp()
    seen, per_day, models = set(), {}, {}
    today_total = today_output = 0
    for f in PROJECTS.glob("**/*.jsonl"):
        try:
            if f.stat().st_mtime < cutoff:
                continue
            lines = f.open(errors="ignore")
        except OSError:
            continue
        with lines:
            for line in lines:
                if '"usage"' not in line:
                    continue
                try:
                    e = json.loads(line)
                    t = datetime.fromisoformat(e["timestamp"].replace("Z", "+00:00")).astimezone()
                    if t.timestamp() < cutoff:
                        continue
                    msg = e["message"]
                    u = msg["usage"]
                except Exception:
                    continue
                key = (msg.get("id"), e.get("requestId"))
                if key in seen or msg.get("model") == "<synthetic>":
                    continue
                seen.add(key)
                parts = {k: u.get(k, 0) or 0 for k in ("input_tokens", "output_tokens",
                                                       "cache_creation_input_tokens", "cache_read_input_tokens")}
                n = sum(parts.values())
                day = t.date().isoformat()
                per_day[day] = per_day.get(day, 0) + n
                if t >= midnight:
                    today_total += n
                    today_output += parts["output_tokens"]
                    m = models.setdefault(model_name(msg.get("model")),
                                          {"total": 0, "input": 0, "output": 0, "cache": 0})
                    m["total"] += n
                    m["input"] += parts["input_tokens"]
                    m["output"] += parts["output_tokens"]
                    m["cache"] += parts["cache_creation_input_tokens"] + parts["cache_read_input_tokens"]
    day_list = []
    for i in range(days):
        d = (first + timedelta(days=i)).date()
        day_list.append({"date": d.isoformat(), "name": d.strftime("%a"), "today": d == now.date(),
                         "total": per_day.get(d.isoformat(), 0)})
    model_list = [{"name": k, **v} for k, v in sorted(models.items(), key=lambda kv: -kv[1]["total"])]
    return ({"total": today_total, "output": today_output,
             "by_model": {m["name"]: m["total"] for m in model_list}}, day_list, model_list)


MODELS = [tuple(m) for m in CFG["models"]]
WINDOW_S = {"session": 5 * 3600, "weekly_all": 7 * 86400, "weekly_scoped": 7 * 86400}


def current_model():
    """Model of the newest assistant message in the most recently used session log."""
    logs = sorted(PROJECTS.glob("**/*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)
    for f in logs[:3]:
        try:
            lines = f.read_text(errors="ignore").splitlines()
        except OSError:
            continue
        for line in reversed(lines[-400:]):
            if '"model"' in line and '"assistant"' in line:
                try:
                    m = json.loads(line)["message"]["model"]
                except Exception:
                    continue
                if m and m != "<synthetic>":
                    return m
    return ""


def pace(limit):
    """Linear projection from how far into its window a limit is."""
    window = WINDOW_S.get(limit.get("kind"))
    if not window or not limit.get("resets_at"):
        return ""
    reset = datetime.fromisoformat(limit["resets_at"]).timestamp()
    now = time.time()
    left = max(0, reset - now)
    elapsed = window - left
    pct = limit.get("percent", 0) or 0
    if elapsed < window * 0.05 or pct <= 0:
        return "too early to tell" if pct > 0 else "nothing used yet"
    rate = pct / elapsed                      # percent per second
    at_reset = pct + rate * left
    if at_reset < 100:
        return f"on pace for {at_reset:.0f}% by reset"
    hit = datetime.fromtimestamp(now + (100 - pct) / rate).astimezone()
    day = "" if hit.date() == datetime.now().date() else hit.strftime("%a ")
    return f"at this pace: 100% {day}{hit.strftime('%-I:%M %p')}, before reset"


def tmux_args():
    """tmux_target split into (socket args, target args), e.g. "-L claude -t claude"."""
    parts = shlex.split(CFG["tmux_target"])
    sock, target = [], []
    it = iter(parts)
    for p in it:
        if p in ("-L", "-S"):
            sock += [p, next(it, "")]
        elif p == "-t":
            target += [p, next(it, "")]
    return sock, target


def notify(title, body):
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "Claude Code", "-i", "claude-code", title, body])


def running():
    if CFG["tmux_target"]:
        sock, target = tmux_args()
        return subprocess.run(["tmux", *sock, "has-session", *target], capture_output=True).returncode == 0
    return subprocess.run(["pgrep", "-x", "claude"], capture_output=True).returncode == 0


def set_model(model_id):
    if not CFG["tmux_target"]:
        notify("Model switch not set up", "Set tmux_target in ~/.config/claude-usage/config.toml.")
        return
    sock, target = tmux_args()
    if not running():
        notify("Claude Code isn't running", "Start it first, then switch models.")
        return
    subprocess.run(["tmux", *sock, "send-keys", *target, "-l", f"/model {model_id}"])
    subprocess.run(["tmux", *sock, "send-keys", *target, "Enter"])
    name = next((n for n, i in MODELS if i == model_id), model_id)
    notify(f"Model: {name}", "Sent /model to the Claude session.")


def human(n):
    for unit, div in (("B", 1e9), ("M", 1e6), ("k", 1e3)):
        if n >= div:
            return f"{n / div:.1f}{unit}"
    return str(n)


def when(iso):
    if not iso:
        return ""
    t = datetime.fromtimestamp(round(datetime.fromisoformat(iso).timestamp() / 60) * 60).astimezone()
    left = t - datetime.now().astimezone()
    mins = max(0, int(left.total_seconds() // 60))
    rel = f"{mins // 60}h {mins % 60:02d}m" if mins >= 60 else f"{mins}m"
    day = "" if t.date() == datetime.now().date() else t.strftime("%a ")
    return f"resets {day}{t.strftime('%-I:%M %p')} (in {rel})"


def main():
    if "--open" in sys.argv:
        subprocess.Popen(CFG["open_command"], shell=True, start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    if "--running" in sys.argv:
        print("on" if running() else "off")
        return
    if "--set-model" in sys.argv:
        set_model(sys.argv[sys.argv.index("--set-model") + 1])
        return
    lim = fetch_limits()
    today, days, models = token_stats()
    cur = current_model()
    out = {**lim, "plan": plan(), "today": today, "days": days, "models": models,
           "current_model": cur, "can_switch_model": bool(CFG["tmux_target"]),
           "model_choices": [{"name": n, "id": i, "current": i == cur} for n, i in MODELS]}
    for l in out.get("limits", []):
        l["pace"] = pace(l)
    if "--text" not in sys.argv:
        for l in out.get("limits", []):
            l["reset_text"] = when(l.get("resets_at"))
            l["reset_in"] = when(l.get("resets_at")).split("(in ")[-1].rstrip(")") if l.get("resets_at") else ""
        for d in out["days"] + out["models"]:
            d["total_text"] = human(d["total"])
        for m in out["models"]:
            m["split_text"] = f"in {human(m['input'])} · out {human(m['output'])} · cache {human(m['cache'])}"
        out["today_text"] = (f"Today: {human(today['total'])} tokens ({human(today['output'])} output)" +
                             "".join(f"\n   {m}: {human(n)}" for m, n in today["by_model"].items()))
        print(json.dumps(out))
        return
    for l in out.get("limits", []):
        print(f"{l['label']:<22} {l['percent']:>3}%  {when(l.get('resets_at'))}  — {l['pace']}")
    print(f"Today: {human(today['total'])} tokens ({human(today['output'])} output)")
    for m, n in today["by_model"].items():
        print(f"   {m}: {human(n)}")
    if out.get("error"):
        print("note:", out["error"])


if __name__ == "__main__":
    main()
